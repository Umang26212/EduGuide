<link rel="stylesheet" href="/css/style.css">
<%- include("../partials/navbar.ejs") %>
<div class="home-page">

    <section class="hero-section">

        <h1>EduGuide</h1>

        <h2>Find the right college for your future.</h2>

        <p>
            Explore colleges, compare your options, and get personalized
            recommendations based on your preferences.
        </p>

        <div class="hero-buttons">

            <a href="/colleges" class="home-button">
                Explore Colleges
            </a>

            <a href="/recommend" class="home-button secondary">
                Get Recommendations
            </a>

        </div>

    </section>


    <section class="features-section">

        <h2>What can you do with EduGuide?</h2>

        <div class="feature-grid">

            <div class="feature-card">
                <div class="feature-icon">🎓</div>
                <h3>Explore Colleges</h3>
                <p>
                    Search and filter colleges by location, type and courses.
                </p>
                <a href="/colleges">Explore →</a>
            </div>

            <div class="feature-card">
                <div class="feature-icon">⚖️</div>
                <h3>Compare Colleges</h3>
                <p>
                    Compare important college information side by side
                    before making a decision.
                </p>
                <a href="/colleges">Compare →</a>
            </div>

            <div class="feature-card">
                <div class="feature-icon">✨</div>
                <h3>Get Recommendations</h3>
                <p>
                    Tell EduGuide your preferences and discover colleges
                    that match your needs.
                </p>
                <a href="/recommend">Get Started →</a>
            </div>
            <div class="feature-card">

                <div class="feature-icon">
                    📚
                </div>

                <h3>Explore Courses</h3>

                <p>
                    Discover courses and find colleges that offer the course
                    you're interested in.
                </p>

                <a href="/courses">
                    Explore Courses →
                </a>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    🎓
                </div>

                <h3>Find Scholarships</h3>

                <p>
                    Explore scholarship opportunities that can help support
                    your higher education.
                </p>

                <a href="/scholarships">
                    View Scholarships →
                </a>

            </div>

        </div>

    </section>

</div>